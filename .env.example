# ===========================================
# Database (PostgreSQL with the fisi9t_* tables; production uses Neon)
# ===========================================
DB_NAME=mimiciv
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
# Schema that holds the materialized views
DB_SCHEMA=mimiciv_derived
# Neon requires "require"; use "prefer" only for a bare local Postgres without TLS
DB_SSLMODE=require

# ===========================================
# Django
# ===========================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev_secret_key
# Must be False in production
DEBUG=True
# Comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https:// origins; required in production when ALLOWED_HOSTS has a leading-dot wildcard
CSRF_TRUSTED_ORIGINS=

# ===========================================
# Prediction model
# ===========================================
# Leave empty to score in-process with the bundled joblib model (the production setup)
MODEL_SERVICE_URL=
MODEL_SERVICE_TIMEOUT=30
# MODEL_SERVICE_API_KEY=
# Hours of feature history included in each model payload
MODEL_HISTORY_HOURS=6
# LOCAL_MODEL_PATH=models/sepsis_model.joblib

# ===========================================
# Similarity export (management command only)
# ===========================================
# SIMILARITY_CSV_PATH=static/similarity_matrix.csv
